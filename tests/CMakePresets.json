{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "host",
      "displayName": "宿主机单元测试（本机原生编译）",
      "description": "用宿主机编译器编 module/ 的纯计算代码，不接板子。与固件交叉编译工程隔离——根 CMakePresets.json 保持纯交叉，两者不会互相污染。",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "host",
      "configurePreset": "host"
    }
  ],
  "testPresets": [
    {
      "name": "host",
      "configurePreset": "host",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
